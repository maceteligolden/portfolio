# Bloggr public API (server-side only).
# The workspace is inferred from the key pair. Do not add a site id.
BLOG_API_BASE_URL=https://dev-api.bloggr.io/api/v1
BLOG_ACCESS_KEY_ID=
BLOG_SECRET_KEY=

# Contact form (Brevo transactional email)
# BREVO_SENDER_EMAIL must be a sender already verified in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Golden Mac-Eteli
CONTACT_EMAIL=maceteligolden@gmail.com

# Notion lead pipeline
# Share the database with the integration. Properties:
# Name (title), Email (email), Company (text), Message (text),
# Audience, Service, Timeline, Budget, Status, Source (select).
# Status options include New. Source options include website.
NOTION_API_KEY=
NOTION_LEADS_DATABASE_ID=

# Site
NEXT_PUBLIC_SITE_URL=https://maceteligolden.com
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/maceteligolden/intro-call-with-golden
LOG_LEVEL=info
